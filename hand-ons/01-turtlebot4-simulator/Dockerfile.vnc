FROM turtlebot4:x11

ENV DEBIAN_FRONTEND=noninteractive

# A lightweight desktop and VNC server provide a display inside Docker Desktop.
RUN apt-get update && apt-get install -y \
      tigervnc-standalone-server \
      xfce4 \
      dbus-x11 \
      x11-utils \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/container/start_vnc_simulator.sh /usr/local/bin/start_vnc_simulator.sh
RUN chmod +x /usr/local/bin/start_vnc_simulator.sh

ENV DISPLAY=:0
EXPOSE 5900
CMD ["/usr/local/bin/start_vnc_simulator.sh", "gui"]
